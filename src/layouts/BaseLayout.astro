---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; image?: string; home?: boolean; }
const { title = 'Ahmad Farooq | Systems Engineer', description = 'Systems engineer in Lahore building websites, internal tools, and the systems that run them.', image = '/og/default.svg', home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ahmadfarooq.vercel.app');
const imageUrl = new URL(image, canonical);
const schema = home ? {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Ahmad Farooq', url: 'https://ahmadfarooq.vercel.app', jobTitle: 'Systems Engineer',
  worksFor: { '@type': 'Organization', name: 'Zotir Labs' },
  sameAs: ['https://www.linkedin.com/in/byahmadd/', 'https://github.com/byahmadfarooq', 'https://x.com/_byahmad', 'https://www.instagram.com/ahmaddfaroooq/']
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <div class="preloader" data-preloader>
      <div class="pl-inner">
        <div class="pl-name"><span class="pl-word">Ahmad</span><span class="pl-word">Farooq</span></div>
        <div class="pl-count"><span data-pl-count>0</span>%</div>
      </div>
    </div>
    <script is:inline>
      (function(){
        var pl=document.querySelector('[data-preloader]'); if(!pl) return;
        var reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen=false; try{ seen=sessionStorage.getItem('af-seen')==='1'; }catch(e){}
        function finish(){ pl.classList.add('done'); try{sessionStorage.setItem('af-seen','1');}catch(e){} setTimeout(function(){ pl.style.display='none'; },700); }
        if(reduced||seen){ pl.style.display='none'; return; }
        requestAnimationFrame(function(){ pl.classList.add('in'); });
        var cnt=pl.querySelector('[data-pl-count]'), start=performance.now(), dur=1300;
        function tick(now){ var k=Math.min((now-start)/dur,1); if(cnt) cnt.textContent=Math.round(k*100); if(k<1) requestAnimationFrame(tick); else finish(); }
        requestAnimationFrame(tick);
      })();
    </script>
    <div class="dot-grid" aria-hidden="true"></div>
    <a class="skip-link" href="#content">Skip to content</a>
    <Nav />
    <main id="content"><slot /></main>
    <Footer />
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        var grid = document.querySelector('.dot-grid');
        if (!document.documentElement.classList.contains('js')) return;
        els.forEach(function (el) { if (el.getAttribute('data-reveal') === 'group') Array.prototype.forEach.call(el.children, function (c, i) { c.style.setProperty('--i', i); }); });
        if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('in'); }); }
        else {
          var io = new IntersectionObserver(function (entries) { entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -12% 0px', threshold: 0.01 });
          els.forEach(function (el) { io.observe(el); });
        }
        if (grid) { var q = false; addEventListener('scroll', function () { if (q) return; q = true; requestAnimationFrame(function () { grid.style.transform = 'translate3d(0,' + (-(scrollY * 0.15) % 28) + 'px,0)'; q = false; }); }, { passive: true }); }
      })();
    </script>
  </body>
</html>
