---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<BaseLayout title="Work | Ahmad Farooq" description="Selected websites, internal tools, and AI systems built by Ahmad Farooq.">
  <section class="site-shell section-pad page-head">
    <p class="eyebrow">Selected work</p>
    <h1 class="display">Things I've built</h1>
    <p>Websites, internal tools, AI systems. Here's the proof.</p>
  </section>
  <section class="site-shell work-grid">{projects.map((project) => <ProjectCard {...project} large />)}</section>
  <p class="site-shell nda">Additional client work includes content strategy and digital systems.</p>
</BaseLayout>

<style>
  .page-head { padding-bottom: 3rem; }
  h1 { max-width: 60rem; margin: .8rem 0 1.25rem; font-size: clamp(3.5rem, 9vw, 7rem); }
  .page-head > p:last-child { color: #6e6e73; font-size: 1.1rem; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; padding-bottom: 3rem; }
  .nda { margin-bottom: 7rem; color: #86868b; font-size: .875rem; }
  @media (max-width: 720px) { .work-grid { grid-template-columns: 1fr; } }
</style>
