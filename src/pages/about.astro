---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/BookButton.astro';
const groups = [
  { label: 'Build', tools: ['Python', 'JavaScript', 'TypeScript', 'Node'] },
  { label: 'Frontend', tools: ['Astro', 'Next.js', 'React', 'Tailwind', 'Three.js', 'GSAP'] },
  { label: 'Backend & Data', tools: ['SQLite', 'WebSockets', 'REST APIs', 'SMTP / IMAP'] },
  { label: 'AI & Automation', tools: ['OpenAI', 'Claude', 'Gemini', 'Local models (Ollama)', 'n8n', 'Zapier', 'Make'] },
  { label: 'CMS & Design', tools: ['Keystatic', 'WordPress', 'Figma'] },
  { label: 'Ship', tools: ['Vercel', 'Git'] },
];
---

<BaseLayout title="About | Ahmad Farooq" description="About Ahmad Farooq, a developer and builder based in Lahore.">
  <article class="site-shell section-pad about">
    <img class="portrait" src="/ahmad.png" alt="Ahmad Farooq" width="150" height="150" />
    <p class="eyebrow">About</p>
    <h1 class="display">Ahmad Farooq</h1>
    <p class="lead">Systems engineer. I build websites and the systems behind them.</p>
    <div class="story body-copy" data-reveal>
      <p>I'm Ahmad, 20, based in Lahore. I build websites and the machinery that makes them work: CRMs, dashboards, automations, AI agents. Most people pick a side, frontend or backend, design or systems. I don't. The website and the engine behind it are one job to me.</p>
      <p>I'm self-taught. I learned by building things that had to actually run, not by collecting certificates. Kai, a ten-agent assistant that handles outreach, habits, and a live inbox, built in three days on Python and SQLite. A hand-tracking 3D viewer that runs in the browser. A scanner that reads a landing page and tells you what's costing you customers. A donation platform for a nonprofit. The through-line is range: I'll design the brand, write the code, wire the automation, and ship the whole thing.</p>
      <p>I run two companies. Zotir Labs, where we build brands and websites for owner-led businesses, and Kaivex Systems, for local SEO and e-commerce growth. When I'm not building, I write about making things, and about the quiet habit of outsourcing our thinking to machines.</p>
      <p class="closing">You won't find me on camera. You'll find the work, and it holds up.</p>
    </div>
    <section class="tools" data-reveal>
      <h2 class="display">What I work with</h2>
      {groups.map((group) => <div class="tool-group" data-reveal>
        <h3>{group.label}</h3>
        <div class="pills" data-reveal="group">{group.tools.map((item) => <span>{item}</span>)}</div>
      </div>)}
    </section>
    <BookButton href="/contact" label="Book 20 minutes with me" class="about-cta" />
  </article>
</BaseLayout>

<style>
  .about { max-width: 1000px; }
  .portrait { width: 150px; height: 150px; border-radius: 20px; object-fit: cover; display: block; margin-bottom: 1.75rem; }
  h1 { margin: .8rem 0 1rem; font-size: clamp(4rem, 11vw, 8.5rem); }
  .lead { max-width: 44rem; margin: 0 0 3rem; color: #6e6e73; font-size: 1.25rem; line-height: 1.5; }
  .story { max-width: 44rem; font-size: 1.05rem; }
  .story p { margin: 0 0 1.25rem; }
  .story .closing { margin-top: 2rem; color: #1d1d1f; font-weight: 600; }
  .tools { max-width: 44rem; margin-top: 4rem; padding-top: 3rem; border-top: 1px solid #e8e8ed; }
  .tools h2 { margin: 0 0 2.5rem; font-size: clamp(2.25rem, 5vw, 4rem); }
  .tool-group { margin-bottom: 2rem; }
  .tool-group h3 { margin: 0 0 .75rem; color: #66666b; font-size: .75rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .pills { display: flex; flex-wrap: wrap; gap: .6rem; }
  .pills span { padding: .375rem 1rem; border: 1px solid #e8e8ed; border-radius: 999px; color: #6e6e73; font-size: .875rem; transition: border-color .2s ease; }
  .pills span:hover { border-color: #1d1d1f; }
  .about-cta { margin-top: 2rem; }
</style>
