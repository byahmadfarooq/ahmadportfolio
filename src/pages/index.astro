---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftFocusHeading from '../components/SoftFocusHeading.astro';
import RotatingText from '../components/RotatingText.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceRow from '../components/ServiceRow.astro';
import { projects } from '../data/projects';
---

<BaseLayout home title="Ahmad Farooq | Developer" description="Developer in Lahore building websites, internal tools, and AI workflows.">
  <section class="hero site-shell">
    <div class="hero-copy">
      <p class="eyebrow">Ahmad Farooq · Developer</p>
      <SoftFocusHeading text="Websites that look right. Systems that do the work." class="display hero-title" />
      <p class="hero-sub">The site brings people in. The system behind it books the calls, follows up on every lead, and keeps working after you log off. Most of your competitors only built the first half.</p>
      <div class="hero-action">
        <a class="primary-button" href="/contact">Book 20 minutes with me</a>
        <a class="text-link" href="/work">See my work</a>
      </div>
      <div class="rotating-strip"><RotatingText /></div>
    </div>
  </section>

  <section class="section-pad site-shell" data-reveal>
    <p class="eyebrow">Selected work</p>
    <div class="project-grid" data-reveal="group">{projects.map((project) => <ProjectCard {...project} />)}</div>
  </section>

  <section class="section-pad services-wrap" data-reveal>
    <div class="site-shell services-head">
      <p class="eyebrow">What you get</p>
      <h2 class="display">Three things, done right</h2>
    </div>
    <div class="site-shell" data-reveal="group">
      <ServiceRow name="Websites and brands" description="You get a site that looks right and works right. The whole thing." />
      <ServiceRow name="Internal tools and automation" description="Dashboards, CRMs, workflows. Replace the spreadsheets your team hates." />
      <ServiceRow name="AI workflows" description="Agents, bots, smart pipelines. The stuff that runs while you sleep." />
    </div>
  </section>

  <section class="section-pad site-shell about-teaser" data-reveal>
    <p>I'm Ahmad. I'm 20, based in Lahore, and I build things for a living. Not just websites. The whole system behind them.</p>
    <a class="text-link" href="/about">More about me</a>
  </section>
</BaseLayout>

<style>
  .hero { min-height: 85svh; display: flex; align-items: center; padding-block: 7rem; }
  .hero-copy { max-width: 52rem; }
  :global(.hero-title) { margin: 1.2rem 0 0; font-weight: 800; line-height: 1.05; font-size: clamp(3rem, 6vw, 5rem); }
  .hero-sub { max-width: 42rem; margin: 1.5rem 0 0; color: #6e6e73; font-size: clamp(1.125rem, 1.8vw, 1.25rem); line-height: 1.7; }
  .hero-action { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 2rem; }
  .rotating-strip { margin-top: 2.5rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .services-wrap { background: #f3f3f5; }
  .services-head { margin-bottom: 2rem; }
  .services-head h2 { max-width: 48rem; margin: .9rem 0 0; font-size: clamp(2.5rem, 6vw, 5rem); }
  .about-teaser p { max-width: 48rem; margin: 0 0 1.5rem; color: #6e6e73; font-size: clamp(1.6rem, 3.5vw, 3rem); line-height: 1.35; letter-spacing: -.035em; }
  @media (max-width: 800px) { .project-grid { grid-template-columns: 1fr; } }
</style>
