<p class="rotating-text">What I build: <span data-rotating-text aria-live="polite">websites that convert</span></p>

<script>
  const items = ['websites that convert', 'CRMs that run themselves', 'AI that handles your outreach', 'tools your team will actually use'];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-rotating-text]').forEach((node) => {
    if (reduced) return;
    let index = 0;
    setInterval(() => {
      node.classList.add('leaving');
      setTimeout(() => {
        index = (index + 1) % items.length;
        node.textContent = items[index];
        node.classList.remove('leaving');
      }, 400);
    }, 2800);
  });
</script>

<style>
  .rotating-text { margin: 0; color: #86868b; font-size: .875rem; text-align: left; }
  [data-rotating-text] { display: inline-block; transition: opacity .4s ease, transform .4s ease; }
  [data-rotating-text].leaving { opacity: 0; transform: translateY(-6px); }
</style>
