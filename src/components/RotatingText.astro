<p class="rotating-text" data-rotating-text aria-live="polite">A website that converts</p>

<script>
  const items = ['A website that converts', 'A CRM that runs itself', 'AI that handles your outreach', 'Tools your team will use'];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-rotating-text]').forEach((node) => {
    if (reduced) return;
    let index = 0;
    setInterval(() => {
      node.classList.add('leaving');
      setTimeout(() => {
        index = (index + 1) % items.length;
        node.textContent = items[index];
        node.classList.remove('leaving');
      }, 240);
    }, 3000);
  });
</script>

<style>
  .rotating-text { min-height: 1.4rem; margin: 1.25rem 0 0; color: #86868b; font-size: .875rem; text-align: center; transition: opacity .24s ease, transform .24s ease; }
  .rotating-text.leaving { opacity: 0; transform: translateY(-6px); }
</style>
