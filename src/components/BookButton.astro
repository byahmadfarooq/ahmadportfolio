---
interface Props { href?: string; label?: string; small?: boolean; big?: boolean; class?: string; }
const { href = '/contact', label = 'Book 20 minutes with me', small = false, big = false, class: className = '' } = Astro.props;
---
<span class:list={['mag', className]} data-mag>
  <a class:list={['book-btn', { sm: small, big }]} href={href}>
    <span class="lab">{label}</span>
    <span class="chip" aria-hidden="true">
      <svg class="a1" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h11M10 4.5 14.5 9 10 13.5"></path></svg>
      <svg class="a2" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13 13 5M6.5 5H13v6.5"></path></svg>
    </span>
  </a>
</span>

<style>
  .mag { display: inline-block; will-change: transform; }
  .book-btn {
    --mx: 50%; --my: 50%; --ease: cubic-bezier(.2,.8,.2,1);
    position: relative; display: inline-flex; align-items: center; gap: 14px;
    min-height: 52px; padding: 0 6px 0 20px; border-radius: 13px;
    background: #1d1d1f; color: #fbfbfd;
    font: 600 1rem/1 'Manrope', system-ui, sans-serif;
    border: 0; text-decoration: none; cursor: pointer; white-space: nowrap;
    overflow: hidden; isolation: isolate;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.14), inset 0 -1px 0 rgba(0,0,0,.35);
    transition: transform 250ms var(--ease);
  }
  .book-btn::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(110px circle at var(--mx) var(--my), rgba(255,255,255,.16), rgba(255,255,255,0) 70%);
    opacity: 0; transition: opacity 300ms ease;
  }
  .book-btn:hover::before, .book-btn:focus-visible::before { opacity: 1; }
  .book-btn:focus-visible { outline: 2px solid #1d1d1f; outline-offset: 3px; box-shadow: none; }
  .lab { display: block; }
  .chip {
    position: relative; width: 40px; height: 40px; flex: none; border-radius: 10px;
    overflow: hidden; background: #fbfbfd; color: #1d1d1f; transition: width 350ms var(--ease);
  }
  .chip svg { position: absolute; top: 50%; left: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px; transition: transform 380ms var(--ease); }
  .chip .a2 { transform: translate(-28px, 28px); }
  @media (hover: hover) {
    .book-btn:hover .chip, .book-btn:focus-visible .chip { width: 48px; }
    .book-btn:hover .chip .a1, .book-btn:focus-visible .chip .a1 { transform: translate(28px, -28px); }
    .book-btn:hover .chip .a2, .book-btn:focus-visible .chip .a2 { transform: translate(0, 0); }
  }
  .book-btn:active { transform: scale(.98); transition-duration: 120ms; }
  .book-btn.big { min-height: 62px; padding: 0 8px 0 26px; font-size: 1.1rem; }
  .book-btn.sm { min-height: 44px; padding: 0 5px 0 16px; font-size: .9rem; gap: 10px; border-radius: 11px; }
  .book-btn.sm .chip { width: 32px; height: 32px; border-radius: 8px; }
  .book-btn.sm:hover .chip, .book-btn.sm:focus-visible .chip { width: 38px; }
  .book-btn.sm .chip svg { width: 15px; height: 15px; margin: -7.5px 0 0 -7.5px; }
  @media (prefers-reduced-motion: reduce) {
    .book-btn, .book-btn::before, .chip, .chip svg { transition: none; }
    .book-btn:hover .chip .a1, .book-btn:focus-visible .chip .a1,
    .book-btn:hover .chip .a2, .book-btn:focus-visible .chip .a2 { transform: none; }
    .chip .a2 { transform: translate(-28px, 28px); }
  }
</style>

<script>
  (function () {
    const fine = matchMedia('(pointer: fine)').matches;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || reduced) return;
    const items = [...document.querySelectorAll('[data-mag]')].map((el) => ({ el, btn: el.querySelector('.book-btn') })).filter((x) => x.btn);
    items.forEach(({ btn }) => {
      const set = (e) => { const r = btn.getBoundingClientRect(); btn.style.setProperty('--mx', (e.clientX - r.left) + 'px'); btn.style.setProperty('--my', (e.clientY - r.top) + 'px'); };
      btn.addEventListener('pointerenter', set); btn.addEventListener('pointermove', set, { passive: true }); btn.addEventListener('pointerleave', set);
    });
    let pending = null, raf = 0;
    const flush = () => { raf = 0; const e = pending; if (!e) return;
      items.forEach(({ el, btn }) => { if (!btn.offsetParent) return; const r = btn.getBoundingClientRect(); const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2); const dist = Math.hypot(dx, dy), reach = Math.max(r.width, r.height) * 0.9; const k = dist < reach ? 1 - dist / reach : 0; const nx = dist < reach ? Math.max(-6, Math.min(6, dx * 0.14 * k + dx * 0.03)) : 0; const ny = dist < reach ? Math.max(-5, Math.min(5, dy * 0.14 * k + dy * 0.03)) : 0; el.style.transform = 'translate3d(' + nx.toFixed(2) + 'px,' + ny.toFixed(2) + 'px,0)'; });
    };
    addEventListener('pointermove', (e) => { pending = e; if (!raf) raf = requestAnimationFrame(flush); }, { passive: true });
  })();
</script>
