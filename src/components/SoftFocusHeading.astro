---
interface Props { text: string; tag?: 'h1' | 'h2' | 'h3'; class?: string; }
const { text, tag: Tag = 'h1', class: className = '' } = Astro.props;
---

<Tag class={className} data-soft-focus aria-label={text}>
  {text.split(' ').map((word, i) => <span class="word" style={`--i:${i}`} aria-hidden="true">{word}</span>)}
</Tag>

<style>
  [data-soft-focus] { display: flex; flex-wrap: wrap; column-gap: .22em; }
  .word { display: inline-block; animation: soft-focus .6s cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(var(--i) * 60ms); }
  @keyframes soft-focus { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>
