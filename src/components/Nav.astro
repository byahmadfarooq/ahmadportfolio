---
import MobileMenu from './MobileMenu.astro';
import BookButton from './BookButton.astro';
---

<header class="site-nav">
  <div class="nav-inner site-shell">
    <a class="brand" href="/">Ahmad Farooq</a>
    <nav class="desktop-links" aria-label="Primary navigation">
      <a href="/work">Work</a>
      <a href="/about">About</a>
      <a href="/lab-notes">Lab Notes</a>
    </nav>
    <BookButton href="/contact" label="Book 20 minutes with me" small class="nav-cta" />
    <button class="menu-button" type="button" data-open-menu aria-label="Open menu" aria-controls="mobile-menu">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>
</header>
<MobileMenu />

<style>
  .site-nav { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid rgb(232 232 237 / .7); background: rgb(251 251 253 / .82); backdrop-filter: blur(16px); }
  .nav-inner { min-height: 74px; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; gap: 1rem; }
  a { text-decoration: none; }
  .brand { color: #1d1d1f; font-family: 'Bricolage Grotesque', sans-serif; font-size: 1.05rem; font-weight: 700; letter-spacing: -.02em; }
  .desktop-links { display: flex; justify-self: center; gap: 2rem; white-space: nowrap; }
  .desktop-links a { position: relative; min-height: 44px; align-content: center; color: #66666b; font-size: .875rem; font-weight: 600; transition: color .2s ease; }
  .desktop-links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 7px; height: 1px; background: #1d1d1f; transform: scaleX(0); transform-origin: left; transition: transform .2s ease; }
  .desktop-links a:hover::after, .desktop-links a:focus-visible::after { transform: scaleX(1); }
  .desktop-links a:hover { color: #1d1d1f; }
  .nav-cta { justify-self: end; white-space: nowrap; padding: .5rem 1.05rem; min-height: 38px; font-size: .8rem; }
  .menu-button { display: none; justify-self: end; place-items: center; width: 44px; height: 44px; border: 1px solid #e8e8ed; border-radius: 999px; background: transparent; color: #1d1d1f; cursor: pointer; }
  @media (max-width: 767px) { .nav-inner { grid-template-columns: 1fr auto; } .desktop-links, .nav-cta { display: none; } .menu-button { display: grid; } }
</style>
