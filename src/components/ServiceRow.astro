---
interface Props { name: string; description: string; }
const { name, description } = Astro.props;
---

<div class="service-row">
  <h3>{name}</h3>
  <p>{description}</p>
</div>

<style>
  .service-row { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 2rem; align-items: start; padding: 2rem 0; border-bottom: 1px solid #e8e8ed; transition: transform .3s ease, border-color .3s ease; }
  .service-row:hover { transform: translateX(8px); border-color: #66666b; }
  h3, p { margin: 0; }
  h3 { font-family: 'Bricolage Grotesque', sans-serif; font-size: clamp(1.25rem, 2vw, 1.6rem); letter-spacing: -.03em; }
  p { color: #6e6e73; line-height: 1.7; }
  @media (max-width: 700px) { .service-row { grid-template-columns: 1fr; gap: .7rem; } }
  @media (prefers-reduced-motion: reduce) { .service-row:hover { transform: none; } }
</style>
